@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&family=Syne:wght@600;700;800&display=swap');
@import "tailwindcss";

:root {
  color-scheme: dark;
  --bg: #06070b;
  --bg-soft: #0d1118;
  --panel: rgba(16, 22, 31, 0.78);
  --panel-strong: rgba(21, 29, 42, 0.92);
  --text: #f4f7fb;
  --muted: #aab6c7;
  --line: rgba(255, 255, 255, 0.12);
  --cyan: #42d9ff;
  --green: #74f7d2;
  --lime: #a3e635;
  --violet: #a78bfa;
  --pink: #f472b6;
  --shadow: 0 24px 90px rgba(0, 0, 0, 0.45);
  --mouse-x: 50vw;
  --mouse-y: 50vh;
  --scroll-progress: 0;
  --scroll-y: 0px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background:
    radial-gradient(circle at 10% 10%, rgba(66, 217, 255, 0.16), transparent 28rem),
    radial-gradient(circle at 90% 10%, rgba(163, 230, 53, 0.12), transparent 30rem),
    radial-gradient(circle at 55% 55%, rgba(167, 139, 250, 0.12), transparent 34rem),
    var(--bg);
  color: var(--text);
  font-family: Inter, system-ui, sans-serif;
  overflow-x: hidden;
}

.site-cursor-glow {
  position: fixed;
  z-index: 1;
  left: 0;
  top: 0;
  width: 34rem;
  height: 34rem;
  pointer-events: none;
  transform: translate(calc(var(--mouse-x) - 17rem), calc(var(--mouse-y) - 17rem));
  background:
    radial-gradient(circle, rgba(66, 217, 255, 0.16), rgba(116, 247, 210, 0.08) 34%, transparent 68%);
  filter: blur(6px);
  mix-blend-mode: screen;
  opacity: 0.88;
  transition: transform 0.08s linear;
}

.scroll-energy {
  position: fixed;
  z-index: 40;
  top: 96px;
  right: 18px;
  width: 5px;
  height: calc(100vh - 132px);
  overflow: hidden;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
  box-shadow: inset 0 0 18px rgba(0, 0, 0, 0.35);
}

.scroll-energy span {
  display: block;
  width: 100%;
  height: calc(var(--scroll-progress) * 100%);
  min-height: 22px;
  border-radius: inherit;
  background: linear-gradient(180deg, var(--cyan), var(--green), var(--lime));
  box-shadow: 0 0 22px rgba(116, 247, 210, 0.55);
  transition: height 0.16s ease;
}

body::after {
  content: '';
  position: fixed;
  z-index: 39;
  left: var(--mouse-x);
  top: var(--mouse-y);
  width: 22px;
  height: 22px;
  border: 1px solid rgba(116, 247, 210, 0.54);
  border-radius: 50%;
  pointer-events: none;
  transform: translate(-50%, -50%) scale(calc(1 + var(--scroll-progress) * 0.9));
  box-shadow: 0 0 20px rgba(66, 217, 255, 0.22);
  transition: width 0.18s ease, height 0.18s ease, transform 0.08s linear;
}

a {
  color: inherit;
}

button,
input,
textarea {
  font: inherit;
}

.nav {
  position: fixed;
  z-index: 50;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px clamp(18px, 4vw, 54px);
  background: rgba(6, 7, 11, 0.68);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--text);
  text-decoration: none;
  font-family: Syne, sans-serif;
  font-size: 1.05rem;
  font-weight: 800;
}

.brand span,
footer span {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border: 1px solid rgba(116, 247, 210, 0.45);
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(66, 217, 255, 0.24), rgba(116, 247, 210, 0.14));
  color: var(--green);
  font-family: JetBrains Mono, monospace;
  font-size: 0.86rem;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
}

.nav-links a,
.mobile-panel a {
  color: var(--muted);
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.74rem;
  font-weight: 800;
}

.nav-links a:hover,
.mobile-panel a:hover {
  color: var(--green);
}

.nav-links a {
  position: relative;
}

.nav-links a::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -8px;
  height: 1px;
  transform: scaleX(0);
  transform-origin: left;
  background: linear-gradient(90deg, var(--cyan), var(--green));
  transition: transform 0.24s ease;
}

.nav-links a:hover::after {
  transform: scaleX(1);
}

.icon-button {
  display: inline-grid;
  place-items: center;
  width: 42px;
  height: 42px;
  color: var(--text);
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--line);
  border-radius: 10px;
  cursor: pointer;
}

.menu-button {
  display: none;
}

.mobile-panel {
  position: fixed;
  z-index: 80;
  inset: 0 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 24px;
  width: min(82vw, 340px);
  padding: 20px;
  background: rgba(8, 11, 17, 0.96);
  border-left: 1px solid var(--line);
  box-shadow: var(--shadow);
}

.mobile-panel .icon-button {
  align-self: flex-end;
}

.hero {
  position: relative;
  min-height: 100vh;
  display: grid;
  align-items: center;
  padding: 112px clamp(18px, 4vw, 64px) 64px;
  overflow: hidden;
}

.hero-scene {
  position: absolute;
  inset: 0;
  opacity: 0.78;
}

.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
  background-size: 72px 72px;
  mask-image: radial-gradient(circle at 50% 45%, #000 0%, transparent 72%);
}

.hero-content {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(280px, 420px);
  gap: clamp(28px, 5vw, 72px);
  width: min(1180px, 100%);
  margin: 0 auto;
  align-items: center;
}

.hero-copy h1 {
  margin: 18px 0 22px;
  font-family: Syne, sans-serif;
  font-size: clamp(3.2rem, 8.5vw, 7.6rem);
  line-height: 0.9;
  letter-spacing: 0;
}

.hero-copy h1 span {
  display: block;
  width: fit-content;
  margin-top: 12px;
  background: linear-gradient(120deg, var(--green), var(--cyan), var(--violet));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  font-size: clamp(1.35rem, 3vw, 2.25rem);
  line-height: 1.12;
}

.hero-copy p {
  max-width: 680px;
  color: var(--muted);
  font-size: clamp(1rem, 1.8vw, 1.16rem);
  line-height: 1.85;
}

.status-pill,
.primary-btn,
.secondary-btn,
.social-row a,
.project-links a,
.project-links span,
.contact-copy a {
  display: inline-flex;
  align-items: center;
  gap: 9px;
}

.status-pill {
  width: fit-content;
  padding: 10px 14px;
  border: 1px solid rgba(116, 247, 210, 0.28);
  border-radius: 999px;
  color: var(--green);
  background: rgba(116, 247, 210, 0.08);
  font-size: 0.84rem;
  font-weight: 800;
}

.hero-actions,
.social-row,
.project-links {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  align-items: center;
}

.hero-actions {
  margin-top: 30px;
}

.primary-btn,
.secondary-btn {
  position: relative;
  min-height: 48px;
  padding: 0 18px;
  border-radius: 12px;
  text-decoration: none;
  font-weight: 800;
  border: 1px solid transparent;
  cursor: pointer;
  overflow: hidden;
  transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
}

.primary-btn::after,
.secondary-btn::after {
  content: '';
  position: absolute;
  inset: 0;
  transform: translateX(-120%);
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
  transition: transform 0.48s ease;
}

.primary-btn:hover,
.secondary-btn:hover {
  transform: translateY(-3px);
}

.primary-btn:hover::after,
.secondary-btn:hover::after {
  transform: translateX(120%);
}

.primary-btn {
  background: linear-gradient(135deg, var(--cyan), var(--green));
  color: #031012;
  box-shadow: 0 16px 44px rgba(66, 217, 255, 0.24);
}

.secondary-btn {
  color: var(--text);
  background: rgba(255, 255, 255, 0.06);
  border-color: var(--line);
}

.secondary-btn:hover {
  border-color: rgba(116, 247, 210, 0.45);
  box-shadow: 0 12px 34px rgba(116, 247, 210, 0.1);
}

.social-row {
  margin-top: 24px;
}

.social-row a {
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--line);
  color: var(--muted);
  transition: transform 0.22s ease, color 0.22s ease, border-color 0.22s ease;
}

.social-row a:hover {
  transform: translateY(-4px) rotate(-4deg);
  color: var(--green);
  border-color: rgba(116, 247, 210, 0.45);
}

.tech-logo-stage {
  position: relative;
  max-width: 620px;
  margin-top: 30px;
  height: 300px;
  overflow: hidden;
  border: 1px solid rgba(116, 247, 210, 0.18);
  border-radius: 26px;
  background:
    radial-gradient(circle at 25% 12%, rgba(255, 255, 255, 0.16), transparent 8rem),
    radial-gradient(circle at 20% 40%, rgba(66, 217, 255, 0.2), transparent 16rem),
    radial-gradient(circle at 82% 35%, rgba(116, 247, 210, 0.16), transparent 16rem),
    linear-gradient(145deg, rgba(15, 23, 42, 0.88), rgba(2, 6, 23, 0.72));
  box-shadow: 0 28px 80px rgba(0, 0, 0, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  perspective: 900px;
  cursor: grab;
  isolation: isolate;
}

.tech-logo-stage:hover {
  border-color: rgba(116, 247, 210, 0.34);
  box-shadow: 0 34px 100px rgba(0, 0, 0, 0.52), 0 0 46px rgba(66, 217, 255, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.14);
}

.tech-logo-stage::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
  background-size: 34px 34px;
  mask-image: radial-gradient(circle at 50% 42%, black, transparent 78%);
  pointer-events: none;
}

.tech-logo-stage canvas {
  display: block;
  width: 100% !important;
  height: 100% !important;
}

.tech-logo-stage-labels {
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 14px;
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  justify-content: center;
  pointer-events: none;
}

.tech-logo-stage-labels span {
  padding: 6px 9px;
  border: 1px solid color-mix(in srgb, var(--tone) 48%, transparent);
  border-radius: 999px;
  color: color-mix(in srgb, var(--tone) 78%, white);
  background: rgba(5, 8, 13, 0.68);
  font-family: JetBrains Mono, monospace;
  font-size: 0.64rem;
  font-weight: 800;
  backdrop-filter: blur(10px);
}

.tech-logo-stage::after {
  content: 'interactive studio 3D logos';
  position: absolute;
  top: 12px;
  right: 14px;
  color: rgba(244, 247, 251, 0.5);
  font-family: JetBrains Mono, monospace;
  font-size: 0.62rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.profile-card,
.glass-panel,
.skill-card,
.project-card,
.timeline-item,
.cred-card,
.github-card,
.contact-copy,
.contact-form {
  border: 1px solid var(--line);
  background: var(--panel);
  backdrop-filter: blur(18px);
  box-shadow: var(--shadow);
}

.profile-card {
  position: relative;
  padding: 22px;
  border-radius: 24px;
  overflow: hidden;
  isolation: isolate;
}

.profile-card::before {
  content: '';
  position: absolute;
  inset: -1px;
  z-index: -1;
  background:
    linear-gradient(120deg, rgba(66, 217, 255, 0.22), transparent 35%, rgba(116, 247, 210, 0.18)),
    repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.04) 0 1px, transparent 1px 18px);
  opacity: 0.72;
}

.profile-card::after {
  content: '</>';
  position: absolute;
  right: 18px;
  bottom: 18px;
  color: rgba(116, 247, 210, 0.15);
  font-family: JetBrains Mono, monospace;
  font-size: 3rem;
  font-weight: 800;
}

.profile-photo {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 20px;
  border: 1px solid rgba(116, 247, 210, 0.3);
  background: linear-gradient(145deg, rgba(66, 217, 255, 0.16), rgba(167, 139, 250, 0.14));
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 0 46px rgba(66, 217, 255, 0.12);
}

.profile-photo::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent, rgba(6, 7, 11, 0.18)), linear-gradient(90deg, transparent 0 48%, rgba(116, 247, 210, 0.24) 50%, transparent 52%);
  mix-blend-mode: screen;
  animation: scan-profile 3.8s ease-in-out infinite;
}

.profile-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.wave-hand {
  position: absolute;
  z-index: 5;
  right: 12%;
  bottom: 7%;
  width: 82px;
  height: 82px;
  transform: translateY(42px) rotate(-18deg) scale(0.68);
  transform-origin: 32% 88%;
  opacity: 0;
  filter: drop-shadow(0 16px 18px rgba(0, 0, 0, 0.32));
  transition: opacity 0.22s ease, transform 0.22s ease;
  pointer-events: none;
}

.profile-card:hover .wave-hand {
  opacity: 1;
  transform: translateY(0) rotate(-12deg) scale(1);
  animation: hand-wave 1.15s ease-in-out infinite;
}

.hand-palm,
.hand-finger,
.hand-thumb,
.hand-cuff {
  position: absolute;
  display: block;
  background: linear-gradient(145deg, #ffe0b5, #f59e0b 70%, #b45309);
  border: 1px solid rgba(255, 255, 255, 0.28);
  box-shadow: inset 8px 8px 14px rgba(255, 255, 255, 0.2), inset -8px -10px 16px rgba(120, 53, 15, 0.28);
}

.hand-palm {
  left: 24px;
  top: 35px;
  width: 36px;
  height: 38px;
  border-radius: 18px 18px 16px 16px;
}

.hand-finger {
  width: 12px;
  height: 38px;
  top: 8px;
  border-radius: 999px;
  transform-origin: bottom center;
}

.finger-1 {
  left: 18px;
  height: 34px;
  transform: rotate(-12deg);
}

.finger-2 {
  left: 31px;
  height: 42px;
}

.finger-3 {
  left: 45px;
  height: 39px;
  transform: rotate(6deg);
}

.finger-4 {
  left: 58px;
  height: 31px;
  transform: rotate(15deg);
}

.hand-thumb {
  left: 13px;
  top: 42px;
  width: 14px;
  height: 32px;
  border-radius: 999px;
  transform: rotate(-48deg);
}

.hand-cuff {
  left: 28px;
  bottom: 0;
  width: 30px;
  height: 22px;
  border-radius: 8px 8px 12px 12px;
  background: linear-gradient(135deg, var(--cyan), var(--green));
}

@keyframes hand-wave {
  0%,
  100% {
    rotate: -8deg;
  }
  25% {
    rotate: 12deg;
  }
  50% {
    rotate: -4deg;
  }
  75% {
    rotate: 10deg;
  }
}

.profile-orbit {
  position: absolute;
  inset: 10px 10px auto auto;
  width: calc(100% - 20px);
  aspect-ratio: 1;
  pointer-events: none;
  z-index: 3;
}

.profile-orbit > i {
  position: absolute;
  inset: 8px;
  border: 1px dashed rgba(116, 247, 210, 0.22);
  border-radius: 24px;
  animation: orbit-border 14s linear infinite;
}

.profile-orbit > i:nth-of-type(2) {
  inset: 28px;
  border-color: rgba(66, 217, 255, 0.18);
  animation-direction: reverse;
  animation-duration: 18s;
}

.orbit-chip {
  position: absolute;
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: 16px;
  border: 1px solid color-mix(in srgb, var(--tone) 60%, transparent);
  background: rgba(8, 12, 18, 0.78);
  box-shadow: 0 0 24px color-mix(in srgb, var(--tone) 24%, transparent);
  animation: orbit-chip 4s ease-in-out infinite;
}

.orbit-chip img {
  width: 28px;
  height: 28px;
}

.orbit-1 {
  top: 8px;
  left: 18px;
}

.orbit-2 {
  top: 34px;
  right: 6px;
  animation-delay: 0.3s;
}

.orbit-3 {
  right: 20px;
  bottom: 130px;
  animation-delay: 0.6s;
}

.orbit-4 {
  bottom: 154px;
  left: 2px;
  animation-delay: 0.9s;
}

@keyframes scan-profile {
  0% {
    transform: translateX(-70%);
    opacity: 0;
  }
  45%,
  55% {
    opacity: 1;
  }
  100% {
    transform: translateX(70%);
    opacity: 0;
  }
}

@keyframes orbit-border {
  to {
    transform: rotate(360deg);
  }
}

@keyframes orbit-chip {
  0%,
  100% {
    transform: translateY(0) rotateZ(-3deg);
  }
  50% {
    transform: translateY(-10px) rotateZ(5deg);
  }
}

.profile-card h3 {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 4px 0 18px;
  font-size: 1.24rem;
}

.mini-stack,
.tags,
.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.mini-stack span,
.tags span,
.skill-tags span {
  padding: 7px 10px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.06);
  color: var(--muted);
  font-size: 0.82rem;
}

.mono {
  margin: 0;
  color: var(--green);
  font-family: JetBrains Mono, monospace;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.metrics-band {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  width: min(1180px, calc(100% - 36px));
  margin: -34px auto 0;
  position: relative;
  z-index: 5;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 20px;
  background: rgba(10, 15, 22, 0.9);
  box-shadow: var(--shadow);
}

.metric {
  position: relative;
  padding: 24px;
  border-right: 1px solid var(--line);
  transform-style: preserve-3d;
  transition: transform 0.28s ease, background 0.28s ease, box-shadow 0.28s ease;
}

.metric::before {
  content: '';
  position: absolute;
  inset: 10px;
  border-radius: 16px;
  background: radial-gradient(circle at 50% 0%, rgba(116, 247, 210, 0.18), transparent 68%);
  opacity: 0;
  transition: opacity 0.28s ease;
}

.metric:hover {
  z-index: 2;
  transform: perspective(900px) rotateX(8deg) rotateY(-8deg) translateY(-8px);
  background: rgba(255, 255, 255, 0.035);
  box-shadow: 0 28px 60px rgba(0, 0, 0, 0.36);
}

.metric:hover::before {
  opacity: 1;
}

.metric:last-child {
  border-right: 0;
}

.metric strong {
  position: relative;
  display: block;
  margin-bottom: 4px;
  color: var(--green);
  font-family: Syne, sans-serif;
  font-size: clamp(1.6rem, 4vw, 2.5rem);
  text-shadow:
    0 1px 0 #2dd4bf,
    0 2px 0 rgba(20, 184, 166, 0.55),
    0 12px 28px rgba(116, 247, 210, 0.22);
  transition: transform 0.28s ease, text-shadow 0.28s ease;
}

.metric:hover strong {
  transform: translateZ(36px) scale(1.08);
  text-shadow:
    0 1px 0 #99f6e4,
    0 3px 0 rgba(45, 212, 191, 0.8),
    0 7px 0 rgba(8, 145, 178, 0.35),
    0 22px 34px rgba(116, 247, 210, 0.4);
}

.metric span {
  position: relative;
  color: var(--muted);
  font-size: 0.9rem;
}

.section {
  width: min(1180px, calc(100% - 36px));
  margin: 0 auto;
  padding: 104px 0 0;
}

.section-heading {
  max-width: 760px;
  margin-bottom: 34px;
}

.section-heading p {
  margin: 0 0 10px;
  color: var(--green);
  font-family: JetBrains Mono, monospace;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-size: 0.82rem;
}

.section-heading h2 {
  margin: 0;
  font-family: Syne, sans-serif;
  font-size: clamp(2rem, 5vw, 4rem);
  line-height: 1;
  letter-spacing: 0;
}

.section-heading span {
  display: block;
  margin-top: 16px;
  color: var(--muted);
  line-height: 1.75;
}

.about-layout,
.skills-grid,
.cred-grid,
.contact-layout {
  display: grid;
  gap: 18px;
}

.about-layout {
  grid-template-columns: repeat(3, 1fr);
}

.glass-panel,
.skill-card,
.cred-card,
.contact-copy,
.contact-form {
  border-radius: 20px;
  padding: 24px;
}

.glass-panel {
  position: relative;
  overflow: hidden;
  transform-style: preserve-3d;
  transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
}

.glass-panel::before {
  content: '';
  position: absolute;
  inset: -40%;
  background: conic-gradient(from 180deg, transparent, rgba(66, 217, 255, 0.16), rgba(116, 247, 210, 0.18), transparent 35%);
  opacity: 0;
  animation: panel-glow-spin 9s linear infinite;
  transition: opacity 0.3s ease;
}

.glass-panel > * {
  position: relative;
  z-index: 1;
}

.glass-panel:hover {
  transform: perspective(900px) rotateX(5deg) rotateY(4deg) translateY(-8px);
  border-color: rgba(116, 247, 210, 0.38);
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.46), 0 0 36px rgba(66, 217, 255, 0.1);
}

.glass-panel:hover::before {
  opacity: 1;
}

.glass-panel svg,
.cred-card svg {
  color: var(--green);
}

.glass-panel:hover svg {
  filter: drop-shadow(0 0 16px rgba(116, 247, 210, 0.7));
  transform: translateZ(26px) rotate(-5deg) scale(1.08);
}

.glass-panel h3,
.skill-card h3,
.project-card h3,
.timeline-item h3,
.contact-copy h3 {
  margin: 14px 0 10px;
  font-family: Syne, sans-serif;
  font-size: 1.35rem;
}

.glass-panel p,
.project-card p,
.timeline-item p,
.contact-copy p {
  color: var(--muted);
  line-height: 1.75;
}

.skills-grid {
  grid-template-columns: repeat(2, 1fr);
}

.skill-card {
  position: relative;
  min-height: 260px;
  overflow: hidden;
  transform-style: preserve-3d;
  transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
}

.skill-card::before {
  content: '';
  position: absolute;
  inset: -40%;
  background: conic-gradient(from 90deg, transparent, rgba(66, 217, 255, 0.22), rgba(116, 247, 210, 0.2), transparent 40%);
  opacity: 0;
  transition: opacity 0.3s ease;
  animation: skill-glow-spin 8s linear infinite;
}

.skill-card::after {
  content: '';
  position: absolute;
  inset: 1px;
  border-radius: 19px;
  background: linear-gradient(145deg, rgba(16, 22, 31, 0.93), rgba(7, 10, 15, 0.82));
  z-index: 0;
}

.skill-card > * {
  position: relative;
  z-index: 1;
}

.skill-card:hover {
  transform: translateY(-8px) rotateX(3deg) rotateY(-3deg);
  border-color: rgba(116, 247, 210, 0.42);
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.54), 0 0 34px rgba(66, 217, 255, 0.1);
}

.skill-card:hover .skill-logo {
  transform: translateZ(34px) rotate(-5deg);
  border-color: rgba(116, 247, 210, 0.38);
}

.skill-tags span {
  transition: transform 0.18s ease, color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
}

.skill-tags span:hover {
  transform: translateY(-4px) scale(1.04);
  color: var(--text);
  border-color: rgba(116, 247, 210, 0.38);
  background: rgba(116, 247, 210, 0.09);
}

@keyframes panel-glow-spin {
  to {
    transform: rotate(360deg);
  }
}

.skill-card:hover::before {
  opacity: 1;
}

.skill-head {
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 16px;
  align-items: start;
}

.skill-logo {
  display: grid;
  place-items: center;
  width: 64px;
  height: 64px;
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
  box-shadow: inset 0 0 28px rgba(66, 217, 255, 0.1);
}

.skill-logo img {
  width: 38px;
  height: 38px;
  object-fit: contain;
  animation: skill-logo-pulse 3.5s ease-in-out infinite;
}

.skill-card h3 {
  margin-top: 0;
}

.skill-card p {
  margin: 0 0 16px;
  color: var(--muted);
  line-height: 1.6;
  font-size: 0.92rem;
}

.skill-meter {
  height: 9px;
  overflow: hidden;
  margin: 20px 0;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
}

.skill-meter span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--cyan), var(--green), var(--lime));
  box-shadow: 0 0 24px rgba(116, 247, 210, 0.36);
  animation: meter-breathe 2.8s ease-in-out infinite;
}

@keyframes skill-glow-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes skill-logo-pulse {
  50% {
    transform: scale(1.12) rotate(6deg);
  }
}

@keyframes meter-breathe {
  50% {
    filter: brightness(1.35);
  }
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28px;
}

.project-card {
  position: relative;
  overflow: hidden;
  border-radius: 18px;
  isolation: isolate;
  --project-accent: var(--green);
  --project-accent-soft: rgba(116, 247, 210, 0.2);
  background:
    radial-gradient(circle at 18% 4%, color-mix(in srgb, var(--project-accent) 24%, transparent), transparent 16rem),
    linear-gradient(150deg, rgba(12, 18, 28, 0.96), rgba(7, 11, 18, 0.92));
  transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
}

.project-card:nth-child(2n) {
  --project-accent: var(--violet);
  --project-accent-soft: rgba(167, 139, 250, 0.22);
}

.project-card:nth-child(3n) {
  --project-accent: var(--pink);
  --project-accent-soft: rgba(244, 114, 182, 0.18);
}

.project-card::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
    linear-gradient(0deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
  background-size: 38px 38px;
  mask-image: linear-gradient(180deg, black, transparent 58%);
  opacity: 0.5;
}

.project-card::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(110deg, transparent 18%, rgba(255, 255, 255, 0.1), transparent 42%);
  transform: translateX(-120%);
  transition: transform 0.7s ease;
}

.project-card:hover {
  transform: translateY(-10px);
  border-color: color-mix(in srgb, var(--project-accent) 48%, transparent);
  box-shadow: 0 34px 95px rgba(0, 0, 0, 0.58), 0 0 48px color-mix(in srgb, var(--project-accent) 18%, transparent);
}

.project-card:hover::after {
  transform: translateX(120%);
}

.project-visual {
  position: relative;
  min-height: 295px;
  padding: 56px 38px 24px;
  overflow: hidden;
  background:
    radial-gradient(circle at 18% 22%, var(--project-accent-soft), transparent 13rem),
    radial-gradient(circle at 84% 0%, rgba(66, 217, 255, 0.16), transparent 12rem),
    linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent);
}

.project-number,
.featured-pill {
  position: absolute;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  min-height: 42px;
  border: 1px solid color-mix(in srgb, var(--project-accent) 42%, transparent);
  background: color-mix(in srgb, var(--project-accent) 12%, rgba(255, 255, 255, 0.04));
  box-shadow: 0 0 30px color-mix(in srgb, var(--project-accent) 18%, transparent);
  font-family: JetBrains Mono, monospace;
  font-weight: 800;
}

.project-number {
  top: 18px;
  left: 24px;
  justify-content: center;
  width: 58px;
  border-radius: 16px;
  color: var(--project-accent);
  font-size: 1.12rem;
}

.featured-pill {
  top: 22px;
  right: 24px;
  gap: 8px;
  padding: 0 14px;
  border-radius: 999px;
  color: color-mix(in srgb, var(--project-accent) 82%, white);
  font-size: 0.78rem;
}

.mock-screen {
  position: relative;
  width: 100%;
  min-height: 215px;
  display: grid;
  grid-template-columns: 118px 1fr;
  grid-template-rows: 30px 1fr;
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--project-accent) 46%, transparent);
  border-radius: 16px;
  background: rgba(5, 8, 13, 0.78);
  box-shadow: 0 24px 52px rgba(0, 0, 0, 0.42), 0 0 36px color-mix(in srgb, var(--project-accent) 18%, transparent);
  transform: perspective(900px) rotateX(5deg) rotateY(-6deg) translateY(0);
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.project-card:hover .mock-screen,
.project-card:hover .project-video-frame {
  transform: perspective(900px) rotateX(0deg) rotateY(0deg) translateY(-5px);
}

.mock-browser {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 0 12px;
  background: rgba(255, 255, 255, 0.08);
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.mock-browser span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--pink);
}

.mock-browser span:nth-child(2) {
  background: #facc15;
}

.mock-browser span:nth-child(3) {
  background: var(--green);
}

.mock-sidebar {
  display: grid;
  align-content: start;
  gap: 8px;
  padding: 14px 10px;
  background: rgba(255, 255, 255, 0.045);
  border-right: 1px solid rgba(255, 255, 255, 0.1);
}

.mock-sidebar b {
  height: 24px;
  padding: 5px 8px;
  overflow: hidden;
  border-radius: 7px;
  color: rgba(244, 247, 251, 0.82);
  background: rgba(255, 255, 255, 0.07);
  font-size: 0.62rem;
  white-space: nowrap;
}

.mock-content {
  display: grid;
  gap: 10px;
  padding: 14px;
}

.mock-title {
  width: min(100%, 280px);
  overflow: hidden;
  color: var(--text);
  font-family: Syne, sans-serif;
  font-size: 0.9rem;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mock-chart {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: end;
  gap: 8px;
  min-height: 72px;
}

.mock-chart i {
  display: block;
  border-radius: 8px 8px 3px 3px;
  background: linear-gradient(180deg, var(--cyan), var(--green));
  animation: bar-jump 2.4s ease-in-out infinite;
}

.mock-chart i:nth-child(1) {
  height: 42%;
}

.mock-chart i:nth-child(2) {
  height: 78%;
  animation-delay: 0.2s;
}

.mock-chart i:nth-child(3) {
  height: 56%;
  animation-delay: 0.4s;
}

.mock-chart i:nth-child(4) {
  height: 88%;
  animation-delay: 0.6s;
}

.mock-rows {
  display: grid;
  gap: 7px;
}

.mock-rows span {
  height: 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
}

.mock-rows span:nth-child(2) {
  width: 78%;
}

.mock-rows span:nth-child(3) {
  width: 58%;
}

.mock-screen.food {
  --cyan: #fb923c;
  --green: #facc15;
}

.mock-screen.banking {
  --cyan: #60a5fa;
  --green: #22c55e;
}

.mock-screen.commerce {
  --cyan: #f472b6;
  --green: #a78bfa;
}

.mock-screen.dashboard {
  --cyan: #42d9ff;
  --green: #74f7d2;
}

.project-video-frame {
  position: relative;
  overflow: hidden;
  width: 100%;
  aspect-ratio: 16 / 9;
  border: 1px solid color-mix(in srgb, var(--project-accent) 48%, transparent);
  border-radius: 16px;
  background: rgba(4, 8, 13, 0.78);
  box-shadow: 0 24px 52px rgba(0, 0, 0, 0.44), 0 0 36px color-mix(in srgb, var(--project-accent) 18%, transparent);
  transform: perspective(900px) rotateX(5deg) rotateY(-6deg) translateY(0);
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.project-video-frame video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: #05080d;
}

.video-play-orb {
  position: absolute;
  left: 50%;
  top: 50%;
  display: grid;
  place-items: center;
  width: 74px;
  height: 74px;
  border: 2px solid var(--project-accent);
  border-radius: 999px;
  color: white;
  background: rgba(5, 8, 13, 0.62);
  box-shadow: 0 0 34px color-mix(in srgb, var(--project-accent) 54%, transparent);
  transform: translate(-50%, -50%);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.25s ease;
}

.project-video-frame:has(video:hover) .video-play-orb,
.project-video-frame:has(video:focus) .video-play-orb {
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.84);
}

@keyframes bar-jump {
  50% {
    transform: scaleY(0.74);
    filter: brightness(1.35);
  }
}

.project-body {
  padding: 26px 28px 30px;
}

.project-body ul {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px 14px;
  margin: 20px 0;
  padding: 0;
  list-style: none;
  color: var(--muted);
  font-size: 0.9rem;
}

.project-body li::before {
  content: '';
  display: inline-block;
  width: 7px;
  height: 7px;
  margin-right: 8px;
  border-radius: 50%;
  background: var(--green);
}

.project-links {
  margin-top: 24px;
}

.project-links a,
.project-links span {
  min-height: 48px;
  padding: 0 18px;
  border-radius: 10px;
  text-decoration: none;
  color: var(--text);
  border: 1px solid rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.045);
  font-size: 0.92rem;
  font-weight: 800;
  transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
}

.project-links a:hover {
  transform: translateY(-3px);
  border-color: color-mix(in srgb, var(--project-accent) 52%, transparent);
  box-shadow: 0 14px 34px color-mix(in srgb, var(--project-accent) 16%, transparent);
}

.project-links .live-link {
  color: white;
  border-color: color-mix(in srgb, var(--project-accent) 54%, transparent);
  background: linear-gradient(135deg, color-mix(in srgb, var(--project-accent) 34%, rgba(255, 255, 255, 0.06)), rgba(255, 255, 255, 0.04));
}

.project-links span {
  color: rgba(244, 247, 251, 0.58);
}

.project-favorite {
  position: absolute;
  right: 22px;
  bottom: 22px;
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border: 0;
  border-radius: 999px;
  color: var(--project-accent);
  background: color-mix(in srgb, var(--project-accent) 12%, rgba(255, 255, 255, 0.04));
  cursor: pointer;
  transition: transform 0.22s ease, background 0.22s ease;
}

.project-favorite:hover {
  transform: translateY(-3px) scale(1.06);
  background: color-mix(in srgb, var(--project-accent) 20%, rgba(255, 255, 255, 0.05));
}

.timeline {
  display: grid;
  gap: 18px;
}

.timeline-item {
  display: grid;
  grid-template-columns: 54px 1fr;
  gap: 18px;
  padding: 24px;
  border-radius: 20px;
}

.timeline-icon {
  display: grid;
  place-items: center;
  width: 54px;
  height: 54px;
  border-radius: 16px;
  color: #041012;
  background: linear-gradient(135deg, var(--cyan), var(--green));
}

.timeline-item strong {
  color: var(--text);
}

.cred-grid {
  grid-template-columns: repeat(5, 1fr);
}

.cred-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  color: var(--muted);
  line-height: 1.55;
}

.github-card {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 18px;
  align-items: center;
  padding: 28px;
  border-radius: 22px;
  color: var(--text);
  text-decoration: none;
}

.github-card > svg {
  color: var(--green);
}

.github-card h3 {
  margin: 4px 0 0;
  font-family: Syne, sans-serif;
  font-size: clamp(1.3rem, 3vw, 2rem);
}

.contact-layout {
  grid-template-columns: 0.9fr 1.1fr;
}

.contact-copy a {
  margin-top: 18px;
  color: var(--green);
  text-decoration: none;
}

.contact-form {
  display: grid;
  gap: 14px;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 14px;
  outline: none;
  padding: 15px 16px;
  background: rgba(255, 255, 255, 0.06);
  color: var(--text);
  resize: vertical;
}

.contact-form input:focus,
.contact-form textarea:focus {
  border-color: rgba(116, 247, 210, 0.55);
}

.contact-form .primary-btn {
  justify-content: center;
}

.form-note {
  margin: 0;
  color: var(--muted);
  font-size: 0.9rem;
}

.form-note.success {
  color: var(--green);
}

.form-note.error {
  color: var(--pink);
}

footer {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14px;
  width: min(1180px, calc(100% - 36px));
  margin: 80px auto 0;
  padding: 28px 0 40px;
  color: var(--muted);
  border-top: 1px solid var(--line);
  text-align: center;
}

@media (max-width: 1040px) {
  .hero-content,
  .contact-layout {
    grid-template-columns: 1fr;
  }

  .profile-card {
    max-width: 440px;
  }

  .about-layout,
  .skills-grid,
  .cred-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 760px) {
  .nav-links {
    display: none;
  }

  .menu-button {
    display: inline-grid;
  }

  .scroll-energy {
    right: 8px;
    width: 4px;
  }

  .hero {
    padding-top: 100px;
  }

  .hero-copy h1 {
    font-size: clamp(3rem, 17vw, 5rem);
  }

  .tech-logo-stage {
    height: 250px;
  }

  .metrics-band,
  .projects-grid,
  .about-layout,
  .skills-grid,
  .cred-grid {
    grid-template-columns: 1fr;
  }

  .metric {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .metric:last-child {
    border-bottom: 0;
  }

  .project-body ul {
    grid-template-columns: 1fr;
  }

  .github-card,
  .timeline-item {
    grid-template-columns: 1fr;
  }

  footer {
    flex-direction: column;
  }
}

@media (max-width: 430px) {
  .tech-logo-stage {
    height: 300px;
  }

  .skill-head {
    grid-template-columns: 1fr;
  }

  .mock-screen {
    left: 34px;
    right: 14px;
    grid-template-columns: 92px 1fr;
  }

  .mock-sidebar b {
    font-size: 0.56rem;
  }
}
