      <section id="contact" className="section contact-section">
        <SectionHeading eyebrow="Contact" title="Let us build the next opportunity." copy="EmailJS is wired through environment variables, so your keys stay outside the code." />
        <div className="contact-layout">
          <div className="contact-copy reveal">
            <h3>Open to Java, Spring Boot, backend and full-stack opportunities.</h3>
