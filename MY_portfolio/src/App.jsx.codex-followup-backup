            <textarea name="message" placeholder="Tell me about the role or project" rows="5" required />
            <button type="submit" className="primary-btn" disabled={formState === 'sending'}>
              <Send size={18} />
              {formState === 'sending' ? 'Sending...' : 'Send Message'}
            </button>
            {formState === 'missing-config' && <p className="form-note">EmailJS keys are not added yet. Create a .env file using .env.example.</p>}
            {formState === 'sent' && <p className="form-note success">Message sent successfully.</p>}
            {formState === 'error' && <p className="form-note error">Message failed. Please use direct email for now.</p>}
          </form>
        </div>
      </section>

      <footer>
        <span>{profile.initials}</span>
        <p>Built with React, JSX, Three.js, GSAP, Framer Motion and EmailJS.</p>
      </footer>
    </main>
  )
}

