              <Sparkles size={16} />
              Available for Java, Spring Boot and full-stack roles
            </div>
            <h1>
              {profile.name}
              <span>{profile.roles[roleIndex]}</span>
            </h1>
            <p>{profile.bio}</p>
            <div className="hero-actions">
